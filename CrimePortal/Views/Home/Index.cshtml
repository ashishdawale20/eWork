@{
    ViewData["Title"] = "Crime Portal - Home";
    Layout = null;
}

<!DOCTYPE html>
<html lang="mr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            height: 100vh;
            margin: 0;
            background: linear-gradient(120deg, #0f2027, #203a43, #2c5364);
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
        }

        .home-card {
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 50px;
            max-width: 550px;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        }

            .home-card h1 {
                font-weight: 700;
                margin-bottom: 15px;
            }

            .home-card p {
                font-size: 15px;
                opacity: 0.85;
            }

        .login-btn {
            margin-top: 30px;
            padding: 14px 35px;
            font-size: 18px;
            border-radius: 50px;
            background: linear-gradient(90deg, #f7971e, #ffd200);
            color: #000;
            border: none;
            font-weight: 600;
            transition: 0.3s;
        }

            .login-btn:hover {
                transform: scale(1.05);
                box-shadow: 0 10px 25px rgba(255,210,0,0.6);
            }

        .badge-custom {
            background: #ff4b2b;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            margin-bottom: 15px;
            display: inline-block;
        }

        footer {
            position: absolute;
            bottom: 15px;
            font-size: 12px;
            opacity: .6;
        }
    </style>
</head>
<body>

    <div class="home-card">
        <span class="badge-custom">Crime Portal</span>

        <h1>Crime Management System</h1>
        <p>
            काम जलद गतीने होण्याकरीता पोर्टल
            <br />
            कृपया पुढे जाण्यासाठी लॉगीन करा
        </p>

        <!-- 🔐 USER LOGIN BUTTON -->
        <a asp-controller="Account"
           asp-action="Login"
           class="btn login-btn">
            🔐 User Login
        </a>
    </div>

    <footer>
        © 2025 Crime Portal | 
    </footer>

</body>
</html>
