@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Welcome Login Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #9b5de5, #4895ef);
        }

        .login-container {
            width: 900px;
            height: 550px;
            display: flex;
            border-radius: 15px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 0 30px rgba(0,0,0,0.1);
        }

        /* LEFT SIDE */
        .left-panel {
            flex: 1;
            background: linear-gradient(135deg, #6a11cb, #2575fc);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            position: relative;
        }

            .left-panel h1 {
                font-size: 36px;
                font-weight: 600;
                margin-bottom: 10px;
            }

            .left-panel p {
                font-size: 15px;
                opacity: 0.9;
            }

            .left-panel::after {
                content: '';
                position: absolute;
                bottom: -70px;
                width: 120%;
                height: 150px;
                background: #fff;
                border-radius: 50% 50% 0 0;
            }

        /* RIGHT SIDE */
        .right-panel {
            flex: 1;
            background: #fff;
            padding: 60px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .right-panel h4 {
                color: #222;
                font-size: 22px;
                font-weight: 500;
            }

            .right-panel h5 {
                color: #6a11cb;
                font-weight: 600;
                font-size: 18px;
            }

            .right-panel p {
                color: #444;
                font-size: 14px;
            }

        .form-label {
            font-weight: 500;
            color: #333;
        }

        .form-control {
            border: none;
            border-bottom: 2px solid #6a11cb;
            border-radius: 0;
            outline: none;
            box-shadow: none;
            padding-left: 0;
        }

            .form-control:focus {
                border-color: #2575fc;
            }

        .btn-submit {
            background: linear-gradient(to right, #6a11cb, #2575fc);
            border: none;
            color: white;
            border-radius: 25px;
            padding: 10px;
            font-weight: 600;
            font-size: 15px;
            letter-spacing: 1px;
            transition: 0.3s;
        }

            .btn-submit:hover {
                opacity: 0.9;
            }

        .text-small {
            font-size: 13px;
        }

        a {
            color: #6a11cb;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }

        .website-text {
            position: absolute;
            bottom: 20px;
            font-size: 13px;
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Left Section -->
        <div class="left-panel">
            <h1>Welcome Page</h1>
            <p>Sign In To Your Account</p>
            <p class="website-text">www.Ework.com</p>
        </div>

        <!-- Right Section -->
        <div class="right-panel">
            <h4>Hello !</h4>
            <h5>Good Morning</h5>
            <p class="mb-4">Login Your Account</p>

            <form method="post" asp-action="Login" asp-controller="Account">
                <div class="mb-3">
                    <label class="form-label">User ID</label>
                    <input type="text" name="userName" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="Password" class="form-control" required>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3 text-small">
                    <div>
                        <input type="checkbox" id="remember"> <label for="remember">Remember</label>
                    </div>
                    <a href="#">Forgot Password?</a>
                </div>

                <button type="submit" class="btn btn-submit w-100">SUBMIT</button>

                <div class="text-center mt-3 text-small">
                    <a href="#">Create Account</a>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-2">@ViewBag.Error</div>
                }
            </form>
        </div>
    </div>
</body>
</html>
