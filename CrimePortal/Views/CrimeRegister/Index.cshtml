</div>


<script>
    document.addEventListener('DOMContentLoaded', function () {

        const showSuccess = '@TempData["Success"]';

        if (showSuccess) {
            const modal = new bootstrap.Modal(
                document.getElementById('successModal')
            );
            modal.show();
        }

    });
</script>


<form id="logoutForm" method="post" asp-controller="Account" asp-action="Logout">
    @Html.AntiForgeryToken()
</form>
@section Scripts {
    <script>
        document.getElementById("CaseNumber").addEventListener("blur", function () {
            const year = document.getElementById("Year").value;
            const caseNo = this.value;

            if (!year || !caseNo) return;

            fetch(`/CrimeRegister/CheckCaseNumber?year=${year}&caseNumber=${caseNo}`)
                .then(r => r.json())
                .then(isValid => {
                    if (!isValid) {
                        alert("या वर्षात हा गुन्हा क्रमांक आधीच नोंदवलेला आहे.");
                        document.getElementById("CaseNumber").value = "";
                    }
                });
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
}

