@model CrimePortal.ViewModels.AdminResetPasswordViewModel

@{
    ViewData["Title"] = "Reset User Password";
}

<div class="container mt-5" style="max-width:450px;">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark text-center">
            <h4>Reset User Password</h4>
        </div>

        <div class="card-body">

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success">
                    @ViewBag.Success
                </div>
            }

            <form asp-action="ResetUserPassword" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label class="form-label">User Name</label>
                    <input asp-for="UserName" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">New Password</label>
                    <input asp-for="NewPassword" class="form-control" type="password" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" required />
                </div>

                <button type="submit" class="btn btn-warning w-100">
                    Reset Password
                </button>
            </form>

        </div>
    </div>
</div>
